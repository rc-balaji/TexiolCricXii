rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function sessionPath() {
      return /databases/$(database)/documents/sessions/$(request.auth.uid);
    }

    function hasSession() {
      return signedIn() && exists(sessionPath());
    }

    function currentPlayerId() {
      return hasSession() ? get(sessionPath()).data.playerId : '';
    }

    function isCurrentPlayer(playerId) {
      return currentPlayerId() == playerId;
    }

    function areFriends(ownerPlayerId, viewerPlayerId) {
      return viewerPlayerId != '' &&
        exists(/databases/$(database)/documents/players/$(ownerPlayerId)/friends/$(viewerPlayerId));
    }

    // Anonymous Firebase identity is only a transport/session layer.
    match /sessions/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() &&
        request.auth.uid == uid &&
        request.resource.data.playerId is string &&
        request.resource.data.playerId.matches('^[0-9]{8}$') &&
        exists(/databases/$(database)/documents/players/$(request.resource.data.playerId));
      allow delete: if signedIn() && request.auth.uid == uid;
      allow list: if false;
    }

    // Spark prototype custom credentials. Exact-document GET only; never list/query.
    // Passwords are not stored in plain text. See SECURITY-NOTE.md for limitations.
    match /loginCredentials/{emailKey} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() &&
        request.resource.data.email is string &&
        request.resource.data.playerId is string &&
        request.resource.data.playerId.matches('^[0-9]{8}$') &&
        request.resource.data.passwordSalt is string &&
        request.resource.data.passwordVerifier is string;
      allow update, delete: if signedIn() &&
        currentPlayerId() == resource.data.playerId;
    }

    match /accountStates/{playerId} {
      allow read, write: if signedIn() && isCurrentPlayer(playerId);
    }

    // Public player search is exact numeric-ID lookup.
    match /players/{playerId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() &&
        request.resource.data.playerId == playerId &&
        playerId.matches('^[0-9]{8}$');
      allow update, delete: if signedIn() && isCurrentPlayer(playerId);

      match /contactFields/{field} {
        allow get: if signedIn() && (
          isCurrentPlayer(playerId) ||
          resource.data.visibility == 'everyone' ||
          (resource.data.visibility == 'friends' &&
            areFriends(playerId, currentPlayerId())) ||
          (resource.data.visibility == 'selectedFriends' &&
            areFriends(playerId, currentPlayerId()) &&
            currentPlayerId() in resource.data.audienceIds) ||
          (resource.data.visibility == 'everyoneExceptSelected' &&
            !(currentPlayerId() in resource.data.audienceIds))
        );
        allow list: if false;
        allow create, update, delete: if signedIn() && isCurrentPlayer(playerId);
      }

      match /friends/{friendPlayerId} {
        allow read: if signedIn() && isCurrentPlayer(playerId);
        allow create: if signedIn() &&
          (isCurrentPlayer(playerId) || isCurrentPlayer(friendPlayerId)) &&
          request.resource.data.playerId == friendPlayerId;
        allow delete: if signedIn() &&
          (isCurrentPlayer(playerId) || isCurrentPlayer(friendPlayerId));
        allow update: if false;
      }
    }

    match /friendRequests/{requestId} {
      // Exact GET must also work before a deterministic pair document exists;
      // otherwise the create transaction fails before reaching allow create.
      allow get: if hasSession();
      allow list: if signedIn() &&
        (resource.data.fromPlayerId == currentPlayerId() ||
          resource.data.toPlayerId == currentPlayerId());
      allow create: if signedIn() &&
        request.resource.data.fromPlayerId == currentPlayerId() &&
        request.resource.data.toPlayerId is string &&
        request.resource.data.fromPlayerId != request.resource.data.toPlayerId &&
        request.resource.data.status == 'pending';
      allow update: if false;
      allow delete: if signedIn() &&
        resource.data.status == 'pending' &&
        (resource.data.fromPlayerId == currentPlayerId() ||
          resource.data.toPlayerId == currentPlayerId());
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() &&
        resource.data.recipientPlayerId == currentPlayerId();
      allow create: if signedIn() &&
        request.resource.data.fromPlayerId == currentPlayerId() &&
        request.resource.data.recipientPlayerId is string &&
        request.resource.data.read == false;
      allow update: if signedIn() &&
        resource.data.recipientPlayerId == currentPlayerId() &&
        request.resource.data.recipientPlayerId == resource.data.recipientPlayerId &&
        request.resource.data.fromPlayerId == resource.data.fromPlayerId &&
        request.resource.data.type == resource.data.type &&
        request.resource.data.requestId == resource.data.requestId;
      allow delete: if signedIn() &&
        resource.data.recipientPlayerId == currentPlayerId();
    }

    // Gang data remains available to signed-in CricXii sessions.
    match /gangs/{gangId} {
      allow read, write: if hasSession();
    }

    // Short-lived ID reservations prevent two online devices from ever
    // creating the same random Match ID. They are deleted after canonical
    // match creation; an abandoned reservation is harmless.
    match /matchReservations/{matchId} {
      allow get: if hasSession();
      allow list: if false;
      allow create: if hasSession() &&
        request.resource.data.matchId == matchId &&
        request.resource.data.creatorPlayerId == currentPlayerId() &&
        request.resource.data.originToken is string;
      allow delete: if hasSession() &&
        resource.data.creatorPlayerId == currentPlayerId();
      allow update: if false;
    }

    // Shared match source of truth. Participants can watch. The creator
    // controls setup; the selected tracker may enter score while holding the
    // same single-device control lease.
    match /matches/{matchId} {
      function isParticipant(data) {
        return data.participantIds is list &&
          currentPlayerId() in data.participantIds;
      }

      function isHost(data) {
        return data.creatorPlayerId == currentPlayerId();
      }

      function isTracker(data) {
        return data.trackerPlayerId is string &&
          data.trackerPlayerId == currentPlayerId();
      }

      function ownsControllerLease(data) {
        return data.controllerUid == request.auth.uid &&
          data.controllerPlayerId == currentPlayerId();
      }

      // Creation/revision transactions first GET the exact random Match ID.
      // Queries remain participant-scoped below.
      allow get: if hasSession();
      allow list: if hasSession() && isParticipant(resource.data);

      allow create: if hasSession() &&
        request.resource.data.matchId == matchId &&
        isHost(request.resource.data) &&
        isParticipant(request.resource.data) &&
        request.resource.data.status in ['draft', 'drawing', 'live', 'completed'] &&
        request.resource.data.controllerUid == request.auth.uid &&
        request.resource.data.controllerPlayerId == currentPlayerId();

      // Host can update the full canonical match while retaining identity and
      // the device lease. A second device must first take over the lease.
      allow update: if hasSession() &&
        isHost(resource.data) &&
        request.resource.data.matchId == matchId &&
        request.resource.data.creatorPlayerId == resource.data.creatorPlayerId &&
        isParticipant(request.resource.data) &&
        ownsControllerLease(request.resource.data);

      // The selected tracker/scorer can write live scoring snapshots, but not
      // reassign creator/title/participants/tracker/setup metadata.
      allow update: if hasSession() &&
        isTracker(resource.data) &&
        ownsControllerLease(request.resource.data) &&
        request.resource.data.status in ['live', 'completed'] &&
        request.resource.data.matchId == resource.data.matchId &&
        request.resource.data.creatorPlayerId == resource.data.creatorPlayerId &&
        request.resource.data.participantIds == resource.data.participantIds &&
        request.resource.data.title == resource.data.title &&
        request.resource.data.trackerPlayerId == resource.data.trackerPlayerId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'completedAt',
          'activityAt',
          'eventCount',
          'auditCount',
          'revision',
          'controllerUid',
          'controllerPlayerId',
          'controllerLeaseUntil',
          'participantProfiles',
          'matchJson',
          'updatedAt'
        ]);

      allow delete: if hasSession() && isHost(resource.data);

      match /events/{eventId} {
        allow read: if hasSession() &&
          currentPlayerId() in get(
            /databases/$(database)/documents/matches/$(matchId)
          ).data.participantIds;
        allow write: if hasSession() && (
          get(
            /databases/$(database)/documents/matches/$(matchId)
          ).data.creatorPlayerId == currentPlayerId() ||
          get(
            /databases/$(database)/documents/matches/$(matchId)
          ).data.trackerPlayerId == currentPlayerId()
        );
      }
    }

    match /teamMatchReservations/{matchId} {
      allow get: if hasSession();
      allow list: if false;
      allow create: if hasSession() &&
        request.resource.data.matchId == matchId &&
        request.resource.data.creatorPlayerId == currentPlayerId() &&
        request.resource.data.originToken is string;
      allow delete: if hasSession() &&
        resource.data.creatorPlayerId == currentPlayerId();
      allow update: if false;
    }

    match /teamMatches/{matchId} {
      function isTeamParticipant(data) {
        return data.participantIds is list &&
          currentPlayerId() in data.participantIds;
      }

      function isTeamHost(data) {
        return data.creatorPlayerId == currentPlayerId();
      }

      function isTeamTracker(data) {
        return data.trackerPlayerId is string &&
          data.trackerPlayerId == currentPlayerId();
      }

      function ownsTeamControllerLease(data) {
        return data.controllerUid == request.auth.uid &&
          data.controllerPlayerId == currentPlayerId();
      }

      allow get: if hasSession();
      allow list: if hasSession() && isTeamParticipant(resource.data);

      allow create: if hasSession() &&
        request.resource.data.matchId == matchId &&
        isTeamHost(request.resource.data) &&
        isTeamParticipant(request.resource.data) &&
        request.resource.data.status in ['toss', 'live', 'inningsBreak', 'completed'] &&
        request.resource.data.controllerUid == request.auth.uid &&
        request.resource.data.controllerPlayerId == currentPlayerId();

      allow update: if hasSession() &&
        isTeamHost(resource.data) &&
        request.resource.data.matchId == matchId &&
        request.resource.data.creatorPlayerId == resource.data.creatorPlayerId &&
        isTeamParticipant(request.resource.data) &&
        ownsTeamControllerLease(request.resource.data);

      allow update: if hasSession() &&
        isTeamTracker(resource.data) &&
        ownsTeamControllerLease(request.resource.data) &&
        request.resource.data.matchId == resource.data.matchId &&
        request.resource.data.creatorPlayerId == resource.data.creatorPlayerId &&
        request.resource.data.participantIds == resource.data.participantIds &&
        request.resource.data.title == resource.data.title &&
        request.resource.data.trackerPlayerId == resource.data.trackerPlayerId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'activityAt',
          'completedAt',
          'revision',
          'controllerUid',
          'controllerPlayerId',
          'controllerLeaseUntil',
          'participantProfiles',
          'teamMatchJson',
          'updatedAt'
        ]);

      allow delete: if hasSession() && isTeamHost(resource.data);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
